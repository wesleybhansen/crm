# Example environment configuration
# Copy this file to .env and adjust values for your environment.

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=open-mercato
POSTGRES_PORT=5432

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/open-mercato

# JWT secret for auth tokens (required)
JWT_SECRET=change-me-dev-secret

# Events transport (choose one)
# REDIS_URL=redis://localhost:6379
# or
# EVENTS_REDIS_URL=redis://localhost:6379

# Email provider (optional)
# RESEND_API_KEY=

# Public URL used in emails and onboarding flows
APP_URL=http://localhost:3000

# Enable self-service onboarding (default: false)
SELF_SERVICE_ONBOARDING_ENABLED=false
DEMO_MODE=true

# Enable enterprise-only optional modules (default: false)
# Developer preview is free for local/dev usage.
# Production usage requires a commercial enterprise license.
# Details: https://github.com/open-mercato/open-mercato/blob/main/packages/enterprise/README.md
OM_ENABLE_ENTERPRISE_MODULES=false
# Enable enterprise SSO module (default: false)
# Requires OM_ENABLE_ENTERPRISE_MODULES=true
OM_ENABLE_ENTERPRISE_MODULES_SSO=false

# Admin email to notify about onboarding submissions
ADMIN_EMAIL=ops@your-domain.com

# Node environment
NODE_ENV=development

# GTM Engineer (off by default)
# GTM_ENGINEER_ENABLED=true
# GTM_EXECUTION_ENABLED=true
# Separate weekday research scheduler. This never enables email execution,
# but may reserve provider credits when an exact approved policy is active.
# GTM_AUTO_REFILL_ENABLED=false
# Durable mailbox cursor workers are independently dark. This never enables
# outbound execution and must stay false until isolated mailbox E2E is approved.
# GTM_MAILBOX_INGESTION_ENABLED=false
# Optional observational AI cost estimates. All three values are required;
# absent/invalid values leave estimated_cost_microusd null.
# GTM drafts use gemini-3.7-flash. Google's introductory standard rates are
# 0.75 input / 3.75 output USD per 1M tokens through 2026-12-31. Reconfirm the
# served account rate and version before configuring; thinking is output usage.
# GTM_AI_RATE_CARD_VERSION=
# GTM_AI_INPUT_USD_PER_MILLION_TOKENS=
# GTM_AI_OUTPUT_USD_PER_MILLION_TOKENS=
# New unsubscribe links bind organization + tenant + enrollment + address to
# a rotatable key id. Keep previous keys until every sent link ages out.
# GTM_UNSUBSCRIBE_ACTIVE_KEY_ID=
# GTM_UNSUBSCRIBE_KEYRING={"2026-08":"replace-with-at-least-16-random-characters"}
# Legacy verify-only fallback for links already sent before keyring rollout.
# GTM_UNSUBSCRIBE_SECRET=
# Canonical provider-spend ledger. Tests use fixtures automatically; local
# development may opt in explicitly. Production forbids fixture credits and
# requires both noli-core service credentials.
# GTM_LEDGER=fixture
# NOLI_CORE_SUPABASE_URL=
# NOLI_CORE_SUPABASE_SERVICE_ROLE_KEY=
# Deterministic data adapters are test-only unless explicitly enabled in
# non-production development. This switch is ignored in production.
# GTM_FIXTURE_ADAPTERS_ENABLED=true
# Real providers require an enable switch, API credential, AND explicit
# customer-use approval with frozen terms + price versions. This prevents a
# credential alone from activating unreviewed data rights or stale pricing.
# GTM_APIFY_ENABLED=true
# GTM_APIFY_TOKEN=
# GTM_APIFY_CUSTOMER_USE_APPROVED=false
# Exact supported versions; any other value fails closed.
# GTM_APIFY_ACCOUNT_TIER=BRONZE
# GTM_APIFY_TERMS_VERSION=apify-actor-terms-2026-07-09
# GTM_APIFY_PRICE_VERSION=harvestapi-selected-stack-2026-08-21
# Consumer opportunity sources have independent customer-use, actor/build, and
# price gates. LinkedIn, X, and Threads also have dedicated operational
# switches because a timed-out run, provider drift, or poor useful-opportunity
# economics must not broaden customer source coverage implicitly.
# Keep them false until a labeled benchmark clears the terminal-receipt, quality,
# and cost thresholds for the current tier.
# GTM_APIFY_LINKEDIN_OPPORTUNITY_ENABLED=false
# GTM_APIFY_REDDIT_OPPORTUNITY_USE_APPROVED=false
# GTM_APIFY_REDDIT_SEARCH_PRICE_VERSION=automation-lab-reddit-scraper-0.1.119-bronze-events-2026-08-29
# GTM_APIFY_X_OPPORTUNITY_ENABLED=false
# GTM_APIFY_X_OPPORTUNITY_USE_APPROVED=false
# GTM_APIFY_X_POST_SEARCH_PRICE_VERSION=scraper-one-x-post-search-0.0.154-bronze-events-2026-08-29
# GTM_APIFY_THREADS_OPPORTUNITY_ENABLED=false
# GTM_APIFY_THREADS_OPPORTUNITY_USE_APPROVED=false
# GTM_APIFY_THREADS_SEARCH_PRICE_VERSION=pro100chok-threads-scraper-usage-0.5.1-bronze-events-2026-08-29
# GTM_APIFY_ACTOR_THREADS_SEARCH=pro100chok/threads-scraper-usage
# Selected source capabilities: harvestapi/linkedin-post-comments and the
# independently price-gated harvestapi/linkedin-company-search contract.
# Company search is locked to the reviewed actor/build and conservative
# Free/Bronze price; a general Apify approval cannot activate it by itself.
# GTM_APIFY_COMPANY_PRICE_VERSION=harvestapi-linkedin-company-search-0.0.17-free-bronze-2026-08-22
# Optional explicit value; any value other than the reviewed actor fails closed.
# GTM_APIFY_ACTOR_LINKEDIN_COMPANY_SEARCH=harvestapi/linkedin-company-search
# Dedicated accepted-company decision-maker resolver. Keep this exact price
# gate absent until the R21 dark artifact is deployed for an owner-only probe.
# GTM_APIFY_COMPANY_EMPLOYEES_PRICE_VERSION=harvestapi-linkedin-company-employees-full-0.0.157-finalized-events-2026-08-24
# GTM_APIFY_ACTOR_LINKEDIN_COMPANY_EMPLOYEES=harvestapi/linkedin-company-employees
# Public company-website contact discovery. It uses Apify's maintained raw-HTTP
# crawler with robots respected, no proxy/files/screenshots/AI summary, five
# same-domain pages, and a finalized-usage $0.01 provider ceiling.
# GTM_APIFY_WEBSITE_EMAIL_ENABLED=false
# GTM_APIFY_WEBSITE_EMAIL_PRICE_VERSION=apify-website-content-crawler-0.3.94-free-usage-cap-0.01-retention-7d-2026-08-23
# GTM_APIFY_WEBSITE_EMAIL_RETENTION_DAYS=7
# GTM_APIFY_ACTOR_WEBSITE_CONTENT=apify/website-content-crawler
# Independent SMTP-depth verification for addresses returned by profile enrichment.
# This capability has its own switch and exact actor/build/rate contract.
# GTM_APIFY_EMAIL_VERIFY_ENABLED=false
# GTM_APIFY_EMAIL_VERIFY_PRICE_VERSION=automation-lab-email-enrichment-0.1.49-bronze-0.001-start-0.0027-per-row-2026-08-29
# GTM_APIFY_ACTOR_EMAIL_VERIFY=automation-lab/email-enrichment
# Post search, reactions, X, fallback actors, and all other actor overrides are
# deliberately not selectable until their output and exact billing receipts
# have separate reviewed contracts.
# Compatibility no-op; the reviewed $0.002 rate is code-bound to the price version.
# GTM_APIFY_USD_PER_RESULT=0.002
# Owner-excluded legacy adapters. These variables are retained as explicit
# compatibility documentation but are ignored by the runtime registries.
# LeadMagic V1: people discovery + found-only work email lookup (not selected).
# GTM_LEADMAGIC_ENABLED=false
# GTM_LEADMAGIC_API_KEY=
# GTM_LEADMAGIC_CUSTOMER_USE_APPROVED=false
# GTM_LEADMAGIC_TERMS_VERSION=
# GTM_LEADMAGIC_PRICE_VERSION=
# GTM_LEADMAGIC_USD_PER_PERSON=0.025
# GTM_LEADMAGIC_USD_PER_EMAIL=0.025
# Bouncer V1: independent real-time email verification (not selected).
# GTM_BOUNCER_ENABLED=false
# GTM_BOUNCER_API_KEY=
# GTM_BOUNCER_CUSTOMER_USE_APPROVED=false
# GTM_BOUNCER_TERMS_VERSION=
# GTM_BOUNCER_PRICE_VERSION=
# GTM_BOUNCER_USD_PER_VERIFICATION=0.008
# DataForSEO V1: local company/location discovery through Google Maps results.
# GTM_DATAFORSEO_ENABLED=false
# GTM_DATAFORSEO_LOGIN=
# GTM_DATAFORSEO_PASSWORD=
# GTM_DATAFORSEO_CUSTOMER_USE_APPROVED=false
# Exact reviewed versions; arbitrary labels fail closed.
# GTM_DATAFORSEO_TERMS_VERSION=dataforseo-tos-2026-06-12
# GTM_DATAFORSEO_PRICE_VERSION=google-maps-live-advanced-2026-08-21
# Provider-side JSON retention from the reviewed contract, not Noli's local candidate-retention window.
# GTM_DATAFORSEO_RETENTION_DAYS=30
# Compatibility no-ops: rate and depth are code-bound to $0.002 and one task/up to 100 rows.
# GTM_DATAFORSEO_USD_PER_100_RESULTS=
# GTM_DATAFORSEO_MAX_DEPTH=

# Auto-spawn workers when starting the app (default: true)
# Set to false to run workers separately in production
AUTO_SPAWN_WORKERS=true

# Auto-spawn scheduler polling when QUEUE_STRATEGY=local (default: true)
# Set to false to run scheduler in a separate process
AUTO_SPAWN_SCHEDULER=true

# Base directory for local file-backed queues (default: ./.mercato/queue)
QUEUE_BASE_DIR=./.mercato/queue

# SSL Certificate Configuration
# Path to additional CA certificates for Node.js HTTPS connections
# Required for Raiffeisen Bank API which doesn't send complete certificate chain
# The GeoTrust EV RSA CA G2 intermediate certificate is needed for SSL verification
# Certificate valid until: July 2, 2030
# To update: curl -o certs/geotrust-ev-rsa-ca-g2.pem https://cacerts.digicert.com/GeoTrustEVRSACAG2.crt.pem
NODE_EXTRA_CA_CERTS=./certs/geotrust-ev-rsa-ca-g2.pem

# Hybrid query engine SQL logging (optional, default: false)
# Set to true to log raw SQL statements from the hybrid query engine.
QUERY_ENGINE_DEBUG_SQL=false

# Enable tree profiler for matching resources/entities (comma-separated filters, e.g. * - for all profilers,customers.*, customers.people)
# OM_PROFILE=
# Enable detailed CRUD profiling for matching resources (comma-separated filters, e.g. customers.*, *)
# OM_CRUD_PROFILE=
# Enable hybrid query engine profiling for matching entities (comma-separated filters, e.g. customers.*, customers.people)
# OM_QE_PROFILE=

# Enable cache for CRUD API responses (default: false)
ENABLE_CRUD_API_CACHE=false

# Auto-reindex query indexes when coverage gaps are detected (default: true)
SCHEDULE_AUTO_REINDEX=true

# Skip immediate coverage recalculation on read (default: false)
OPTIMIZE_INDEX_COVERAGE_STATS=false

# Continue serving results from entity indexes when coverage gaps are detected (default: true)
FORCE_QUERY_INDEX_ON_PARTIAL_INDEXES=true

# Hashed search tokenization defaults
OM_SEARCH_ENABLED=true
OM_SEARCH_MIN_LEN=3
OM_SEARCH_ENABLE_PARTIAL=true
OM_SEARCH_HASH_ALGO=sha256
OM_SEARCH_STORE_RAW_TOKENS=false
# Optional comma-separated blocklist of field name substrings to skip during tokenization
# OM_SEARCH_FIELD_BLOCKLIST=password,token,secret,hash

# Search module debug logging (Meilisearch, vector search, reindex operations)
OM_SEARCH_DEBUG=false

# Query index engine debug logging (search:source-has-tokens, coverage, etc.)
OM_QUERY_INDEX_DEBUG=false

# CrudForm extended widget event emission (default: true)
# Controls: onFieldChange, onBeforeNavigate, onVisibilityChange, onAppEvent,
# transformFormData, transformDisplayData, transformValidation.
NEXT_PUBLIC_OM_CRUDFORM_EXTENDED_EVENTS_ENABLED=true

# UMES DevTools panel (default: true)
# Enables the Ctrl+Shift+U keyboard shortcut to open the UMES DevTools panel.
# Set to false in production deployments where DevTools should be hidden.
NEXT_PUBLIC_UMES_DEVTOOLS=true

# Example cross-module injection widgets (default: false)
# Enables example widgets injected into catalog/sales/crm pages.
# Example module todo + menu injections stay enabled regardless of this flag.
NEXT_PUBLIC_OM_EXAMPLE_INJECTION_WIDGETS_ENABLED=false

# Toggle EAV backward compatibility for user-defined entities (custom field values)
# When true, DataEngine will also write to custom_field_values on create/update of custom entities.
# Default is false: values are only stored in custom_entities_storage.
ENTITIES_BACKCOMPAT_EAV_FOR_CUSTOM=false

# Cache strategy (default: memory)
CACHE_STRATEGY=sqlite

# Default TTL in milliseconds (optional)
CACHE_TTL=300000

# Redis Configuration
#REDIS_PORT=6379

# Redis configuration (for redis strategy)
#CACHE_REDIS_URL=redis://localhost:6379

# SQLite configuration (for sqlite strategy)
CACHE_SQLITE_PATH=./data/cache.db

# JSON file configuration (for jsonfile strategy)
#CACHE_JSON_FILE_PATH=./data/cache.json

# Database pooling settings
DB_POOL_MIN=5
DB_POOL_MAX=120
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=10000

# Audit log retention windows
# Core resources (users, roles) keep access history longer to support investigations.
AUDIT_LOGS_CORE_RETENTION_DAYS=7
# Non-core reads rotate aggressively to limit storage.
AUDIT_LOGS_NON_CORE_RETENTION_HOURS=8

# Tenant data encryption (enabled by default)
TENANT_DATA_ENCRYPTION=yes
TENANT_DATA_ENCRYPTION_DEBUG=false
# Preferred fallback key when Vault is unavailable (use a strong 32+ char secret)
TENANT_DATA_ENCRYPTION_FALLBACK_KEY=dev-tenant-encryption-fallback-key-32chars
# Legacy secondary fallback secret (optional)
TENANT_DATA_ENCRYPTION_KEY=
# Hashicorp Vault configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-only-token
VAULT_KV_PATH=secret/data

# ============================================================================
# Embedding Provider Configuration (for vector search)
# ============================================================================
# Vector search requires ONE embedding provider to be configured.
# OpenAI is the default provider if no explicit configuration is set.

# OpenAI (default embedding provider)
# Models: text-embedding-3-small (1536 dim), text-embedding-3-large (3072 dim)
OPENAI_API_KEY=your_openai_api_key_here

# Google Generative AI
# Models: text-embedding-004 (768 dim), embedding-001 (768 dim)
# GOOGLE_GENERATIVE_AI_API_KEY=

# Mistral AI
# Models: mistral-embed (1024 dim)
# MISTRAL_API_KEY=

# Cohere
# Models: embed-english-v3.0 (1024 dim), embed-multilingual-v3.0 (1024 dim)
# COHERE_API_KEY=

# Amazon Bedrock
# Models: amazon.titan-embed-text-v2:0 (1024 dim), cohere.embed-english-v3 (1024 dim)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Ollama (Local/Self-hosted)
# Models: nomic-embed-text (768 dim), mxbai-embed-large (1024 dim), all-minilm (384 dim)
# Default: http://localhost:11434 (no /api suffix needed)
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# OCR (Optical Character Recognition) Configuration
# ============================================================================
# Default OCR model for image and PDF text extraction (optional)
# Falls back to 'gpt-4o' if not specified. Can be overridden per partition.
# Supported models: gpt-4o, gpt-4o-mini
OCR_MODEL=gpt-4o

# Custom OCR prompt (optional, advanced)
# Override the default prompt sent to the LLM for text extraction
# OCR_DEFAULT_PROMPT="Extract all text content from this image..."

# Enable/disable OCR for new partitions by default (default: true)
# OPENMERCATO_DEFAULT_ATTACHMENT_OCR_ENABLED=true

# ============================================================================
# Stripe Integration Preconfiguration
# ============================================================================
# If these values are set, the Stripe provider can preconfigure itself during
# tenant setup and can be rerun later with:
# yarn mercato gateway_stripe configure-from-env --tenant <tenantId> --org <organizationId>
#
# Required for auto-preconfiguration:
# OM_INTEGRATION_STRIPE_PUBLISHABLE_KEY=pk_test_...
# OM_INTEGRATION_STRIPE_SECRET_KEY=sk_test_...
# OM_INTEGRATION_STRIPE_WEBHOOK_SECRET=whsec_...
#
# Optional behavior:
# OM_INTEGRATION_STRIPE_API_VERSION=2025-02-24.acacia
# OM_INTEGRATION_STRIPE_ENABLED=true
# OM_INTEGRATION_STRIPE_FORCE_PRECONFIGURE=false
#
# Notes:
# - Use publishable, secret, and webhook keys from the same Stripe mode.
# - The preset pins the default Stripe API version if you do not set one.
# - Legacy aliases OPENMERCATO_STRIPE_* and STRIPE_* still work.
# OM_INTEGRATION_STRIPE_PUBLISHABLE_KEY=
# OM_INTEGRATION_STRIPE_SECRET_KEY=
# OM_INTEGRATION_STRIPE_WEBHOOK_SECRET=
# OM_INTEGRATION_STRIPE_API_VERSION=2025-02-24.acacia
# OM_INTEGRATION_STRIPE_ENABLED=true
# OM_INTEGRATION_STRIPE_FORCE_PRECONFIGURE=false

# ============================================================================
# Akeneo Sync Preconfiguration
# ============================================================================
# If these credentials are set, the Akeneo provider can preconfigure itself
# during tenant setup and can be rerun later with:
# yarn mercato sync_akeneo configure-from-env --tenant <tenantId> --org <organizationId>
#
# Required for auto-preconfiguration:
# OM_INTEGRATION_AKENEO_API_URL=https://your-instance.cloud.akeneo.com
# OM_INTEGRATION_AKENEO_CLIENT_ID=
# OM_INTEGRATION_AKENEO_CLIENT_SECRET=
# OM_INTEGRATION_AKENEO_USERNAME=
# OM_INTEGRATION_AKENEO_PASSWORD=
#
# Optional behavior:
# OM_INTEGRATION_AKENEO_FORCE_PRECONFIGURE=false
# OM_INTEGRATION_AKENEO_PRODUCT_LOCALE=en_US
# OM_INTEGRATION_AKENEO_CATEGORY_LOCALE=en_US
# OM_INTEGRATION_AKENEO_PRODUCT_CHANNEL=ecommerce
# OM_INTEGRATION_AKENEO_IMPORT_CHANNELS=ecommerce,mobile
# OM_INTEGRATION_AKENEO_IMPORT_ALL_CHANNELS=true
# OM_INTEGRATION_AKENEO_CREATE_MISSING_CHANNELS=true
# OM_INTEGRATION_AKENEO_SYNC_ASSOCIATIONS=true
# OM_INTEGRATION_AKENEO_ATTRIBUTE_FAMILY_FILTER=clothing,cameras
#
# Advanced JSON overrides:
# OM_INTEGRATION_AKENEO_PRODUCTS_SETTINGS_JSON={"settings":{"products":{"subtitleAttribute":"short_description"}}}
# OM_INTEGRATION_AKENEO_CATEGORIES_SETTINGS_JSON={"locale":"en_US"}
# OM_INTEGRATION_AKENEO_ATTRIBUTES_SETTINGS_JSON={"settings":{"attributes":{"familyCodeFilter":["clothing"]}}}
#
# Notes:
# - Only one product locale is imported into base Open Mercato fields at a time.
# - OM_INTEGRATION_AKENEO_IMPORT_CHANNELS is comma-separated.
# - Legacy aliases OPENMERCATO_AKENEO_* and AKENEO_* still work.
# - Leave the block commented out when Akeneo should not be preconfigured.
# OM_INTEGRATION_AKENEO_API_URL=
# OM_INTEGRATION_AKENEO_CLIENT_ID=
# OM_INTEGRATION_AKENEO_CLIENT_SECRET=
# OM_INTEGRATION_AKENEO_USERNAME=
# OM_INTEGRATION_AKENEO_PASSWORD=
# OM_INTEGRATION_AKENEO_FORCE_PRECONFIGURE=false
# OM_INTEGRATION_AKENEO_PRODUCT_LOCALE=
# OM_INTEGRATION_AKENEO_CATEGORY_LOCALE=
# OM_INTEGRATION_AKENEO_PRODUCT_CHANNEL=
# OM_INTEGRATION_AKENEO_IMPORT_CHANNELS=
# OM_INTEGRATION_AKENEO_IMPORT_ALL_CHANNELS=true
# OM_INTEGRATION_AKENEO_CREATE_MISSING_CHANNELS=true
# OM_INTEGRATION_AKENEO_SYNC_ASSOCIATIONS=true
# OM_INTEGRATION_AKENEO_ATTRIBUTE_FAMILY_FILTER=
# OM_INTEGRATION_AKENEO_PRODUCTS_SETTINGS_JSON=
# OM_INTEGRATION_AKENEO_CATEGORIES_SETTINGS_JSON=
# OM_INTEGRATION_AKENEO_ATTRIBUTES_SETTINGS_JSON=

# ============================================================================
# OpenCode AI Assistant Configuration
# ============================================================================
# OpenCode handles AI requests for the AI Assistant feature.
# Configure the provider and set the corresponding API key.

# Provider selection: anthropic, openai, or google (default: anthropic)
OPENCODE_PROVIDER=anthropic

# Optional: Override the default model for the selected provider
# Default models by provider:
#   - anthropic: claude-haiku-4-5-20251001
#   - openai: gpt-4o-mini
#   - google: gemini-3-flash
# OPENCODE_MODEL=anthropic/claude-sonnet-4-20250514

# Provider API keys (set the one matching OPENCODE_PROVIDER)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Master switch to enable/disable rate limiting globally (default: true)
RATE_LIMIT_ENABLED=true

# Storage strategy: 'memory' (single instance) or 'redis' (distributed)
# Redis strategy uses REDIS_URL for connection. Falls back to memory if Redis is unavailable.
RATE_LIMIT_STRATEGY=memory

# Key prefix for rate limiter keys in storage (default: rl)
RATE_LIMIT_KEY_PREFIX=rl

# Number of trusted reverse proxies for X-Forwarded-For IP extraction (default: 1).
# Set to the number of proxies (nginx, CloudFlare, ALB, etc.) between clients and the app.
# 0 = ignore X-Forwarded-For entirely (fall back to X-Real-IP).
# RATE_LIMIT_TRUST_PROXY_DEPTH=1

# Per-endpoint overrides (optional — sensible defaults are hardcoded)
# Auth endpoints use two-layer rate limiting:
#   1) IP-only layer (LOGIN_IP/RESET_IP) — caps total attempts from one IP
#   2) Compound layer (LOGIN/RESET) — caps attempts per IP+account pair (email is SHA-256 hashed)
# RATE_LIMIT_LOGIN_POINTS=5
# RATE_LIMIT_LOGIN_DURATION=60
# RATE_LIMIT_LOGIN_BLOCK_DURATION=60
# RATE_LIMIT_LOGIN_IP_POINTS=20
# RATE_LIMIT_LOGIN_IP_DURATION=60
# RATE_LIMIT_LOGIN_IP_BLOCK_DURATION=60
# RATE_LIMIT_RESET_POINTS=3
# RATE_LIMIT_RESET_DURATION=60
# RATE_LIMIT_RESET_BLOCK_DURATION=60
# RATE_LIMIT_RESET_IP_POINTS=10
# RATE_LIMIT_RESET_IP_DURATION=60
# RATE_LIMIT_RESET_IP_BLOCK_DURATION=60
# RATE_LIMIT_RESET_CONFIRM_POINTS=5
# RATE_LIMIT_RESET_CONFIRM_DURATION=300
# RATE_LIMIT_2FA_VERIFY_POINTS=5
# RATE_LIMIT_2FA_VERIFY_DURATION=300

# ============================================================================
# Meilisearch Configuration (for hybrid search)
# ============================================================================
# Meilisearch provides fast full-text fuzzy search capabilities.
# When configured, it becomes the primary search strategy.
# If not configured, the system falls back to token-based search.

# Meilisearch server URL (required for Meilisearch strategy)
# MEILISEARCH_HOST=http://localhost:7700

# Meilisearch API key (required for production, optional for development)
# MEILISEARCH_API_KEY=your_master_key_here

# Index prefix for tenant isolation (default: om)
# MEILISEARCH_INDEX_PREFIX=om

# ============================================================================
# InboxOps Configuration (email-to-ERP agent)
# ============================================================================
# HMAC secret for validating inbound email webhooks (required for InboxOps)
# INBOX_OPS_WEBHOOK_SECRET=
# Resend webhook signing secret (whsec_... from Resend webhook dashboard)
# Required if using Resend's native inbound email webhooks
# RESEND_WEBHOOK_SIGNING_SECRET=whsec_...
# Domain used for generating inbox forwarding addresses
# INBOX_OPS_DOMAIN=inbox.mercato.local
# Optional: Override default LLM model for email extraction
# INBOX_OPS_LLM_MODEL=
# LLM extraction timeout in milliseconds (default: 90000)
# INBOX_OPS_LLM_TIMEOUT_MS=90000
# Minimum confidence threshold for auto-review (default: 0.5)
# INBOX_OPS_CONFIDENCE_THRESHOLD=0.5
# Maximum email text size in bytes sent to LLM (default: 204800)
# INBOX_OPS_MAX_TEXT_SIZE=204800
# Price mismatch tolerance as decimal fraction (default: 0.05 = 5%)
# INBOX_OPS_PRICE_MISMATCH_THRESHOLD=0.05
