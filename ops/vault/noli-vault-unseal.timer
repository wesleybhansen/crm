# RETIRED 2026-09-16. Vault is no longer the key source for tenant data; the
# derived scheme is (TENANT_KMS_PROVIDER=derived). Do not install or enable this
# unit. On the production box the running copy must be stopped and disabled:
# see crm-vault-retirement-runbook.md.
[Unit]
Description=Keep the Noli CRM Vault instance unsealed

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
Unit=noli-vault-unseal.service

[Install]
WantedBy=timers.target
